rules_version = '2';
// Zikr Deen — Firestore rules.
// 1) "OWNER_EMAIL@gmail.com" ki jagah apni Google email likhein (chhote akshar me).
// 2) Firebase Console > Firestore Database > Rules me poora paste karke Publish dabayein.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'OWNER_EMAIL@gmail.com';
    }

    // Har phone ke anonymous counters (bina login ke likhe jaate hain). Sirf owner padh sakta hai.
    match /guests/{id} {
      allow create, update: if id.size() <= 40
        && request.resource.data.keys().hasOnly(['first','last','opens','asks','td','tday','li','v'])
        && request.resource.data.first is string && request.resource.data.first.size() <= 10
        && request.resource.data.last is string && request.resource.data.last.size() <= 10
        && request.resource.data.opens is int && request.resource.data.opens >= 0 && request.resource.data.opens < 1000000
        && request.resource.data.asks is int && request.resource.data.asks >= 0 && request.resource.data.asks < 1000000
        && request.resource.data.td is int && request.resource.data.td >= 0 && request.resource.data.td < 100000
        && request.resource.data.li is bool;
      allow read: if isOwner();
      allow delete: if false;
    }

    // Google login users: apna doc sirf wo khud padh/likh/delete kar sakta hai. Owner sab padh sakta hai.
    match /users/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','first','last','opens','asks','td','tday','plat','v','backup','bkAt'])
        && (!('backup' in request.resource.data) || request.resource.data.backup.size() < 950000);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
 
    // Provision roles/{uid} in the Firebase Console using a trusted administrator.
    match /classrooms/{code} {
      function hasRole(roles) {
        return request.auth != null &&
          get(/databases/$(database)/documents/classrooms/$(code)/roles/$(request.auth.uid)).data.role in roles;
      }
      allow get: if hasRole(['teacher', 'student']) || isOwner();
      allow create, update: if (hasRole(['teacher']) || isOwner())
        && code.size() <= 20 && request.resource.data.code == code
        && request.resource.data.keys().hasOnly(['code','className','teacherName','liveUrl','json','updatedAt'])
        && request.resource.data.json is string && request.resource.data.json.size() < 500000;
      allow delete: if isOwner();
    }
  }
}
